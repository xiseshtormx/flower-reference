# npm run setup создаст .env с логином и хешем пароля.
FLOWER_STORAGE_DIR=./storage
# Для будущего размещения за прокси: точный HTTPS-адрес сайта.
# FLOWER_PUBLIC_ORIGIN=https://flowers.example.ru
# FLOWER_COOKIE_SECURE=true
# Включайте только за собственным доверенным прокси, который перезаписывает X-Forwarded-For.
# FLOWER_TRUST_PROXY=true
# Необязательные Telegram-уведомления, без телефонов и адресов клиентов.
# FLOWER_TELEGRAM_BOT_TOKEN=
# FLOWER_TELEGRAM_CHAT_ID=
