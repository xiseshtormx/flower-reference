{
  "name": "flower-reference",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev",
    "build": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs build",
    "preview": "node --env-file-if-exists=.env scripts/start.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "setup": "node --env-file-if-exists=.env scripts/setup.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test:integration": "node tests/integration.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.7",
    "@astrojs/react": "7.0.0",
    "astro": "7.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
